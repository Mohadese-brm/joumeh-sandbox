# Names only. No values. Local sandbox needs none.
PORT=
# Demo OTP: returns/logs the mock code. Opt-in for LOCAL testing only (value 1). Never set on Vercel.
JOUMEH_DEMO_OTP=
# Sample overlay. Leave unset. Value 1 blocks every order and paints sample prices on unpriced products.
# This catalogue release is meant to run with the overlay OFF. Live Gerdoo must turn JOUMEH_SAMPLE_OVERLAY off.
JOUMEH_SAMPLE_OVERLAY=
