{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.ts": { "includeFiles": "node_modules/sql.js/dist/sql-wasm.wasm" } },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/|img/|assets/).*)", "destination": "/index.html" }
  ]
}
